---
import { Picture } from 'astro:assets';
import Logo from './Logo.astro';
import street from '../assets/photos/nataliya-street.jpg';
import { section, pick, compact, inline } from '../lib/content';
const a = section('about');
const paragraphs: string[] = pick(a, 'paragraphs');
---
<section id="about" class="section about">
  <div class="wrap about__grid">
    <div class="about__photo">
      <div class="watermark about__wm" aria-hidden="true"><Logo variant="swash" /></div>
      <div class="frame frame--left">
        <div class="frame__clip">
          <Picture src={street} alt={a.photoAlt} widths={[420, 640, 900]} sizes="(max-width: 900px) 92vw, 440px" formats={['avif', 'webp']} data-parallax />
        </div>
      </div>
    </div>
    <div class="about__text">
      <p class="label">{a.eyebrow}</p>
      <h2 class="display about__h" data-reveal>{a.greeting} <span class="accent">{a.name}</span></h2>
      {paragraphs.map((t, i) => <p class:list={['about__p', { 'about__p--lead': i === 0 }]} set:html={inline(t)} />)}
      <p class="display pillars">
        {a.pillars.map((p: string, i: number) => (
          <Fragment>{i > 0 && <span class="accent" aria-hidden="true">·</span>}<span>{p}</span></Fragment>
        ))}
      </p>
      {compact ? (
        <ul class="stats">
          {a.stats.map((s: any) => (
            <li class="stat"><span class="numeral stat__value">{s.value}</span><span class="stat__label">{s.label}</span></li>
          ))}
        </ul>
      ) : (
        <div>
          <h3 class="label label--small">{a.bringLabel}</h3>
          <ul class="bring">
            {a.bring.map((b: string) => <li><span class="accent display" aria-hidden="true">—</span><span>{b}</span></li>)}
          </ul>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .about { padding-top: clamp(24px, 4vw, 40px); }
  .about__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(40px, 6vw, 80px); align-items: start; }
  .about__photo { position: relative; position: sticky; top: 110px; }
  .about__wm { width: 120%; right: -30%; bottom: -14%; }
  .about__text { display: flex; flex-direction: column; gap: 26px; padding-top: 16px; }
  .about__h { margin: 0; font-size: clamp(2.5rem, 5.2vw, 4.75rem); line-height: 1.02; }
  .about__p { margin: 0; }
  .about__p--lead { font-size: 18px; }
  .pillars {
    display: flex; flex-wrap: wrap; align-items: center; gap: 10px 20px; margin: 0;
    padding-block: 24px; border-block: 1px solid var(--rule); font-size: 1.45rem;
  }
  .bring { margin: 8px 0 0; padding: 0; list-style: none; border-top: 1px solid var(--rule); }
  .bring li { display: flex; gap: 16px; padding-block: 15px; border-bottom: 1px solid var(--rule); font-size: 16px; line-height: 1.6; }
  .bring .display { font-size: 20px; line-height: 1.3; }
  .stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; margin: 0; padding: 0; list-style: none; background: var(--rule); border: 1px solid var(--rule); }
  .stat { display: flex; flex-direction: column; gap: 8px; padding: 24px 22px; background: var(--paper); }
  .stat__value { font-size: 3.2rem; line-height: 1; }
  .stat__label { font-size: 13px; line-height: 1.5; }
  @media (max-width: 900px) {
    .about__grid, .stats { grid-template-columns: minmax(0, 1fr); }
    .about__photo { position: relative; top: 0; max-width: 440px; }
  }
</style>
