---
import Logo from './Logo.astro';
import { section } from '../lib/content';
const site = section('site');
---
<header class="nav">
  <div class="wrap nav__inner">
    <a href="/#top" class="nav__logo" aria-label="THEONE Consulting — back to top">
      <Logo variant="horizontal" />
    </a>
    <nav aria-label="Main">
      <ul class="nav__links">
        {site.nav.map((l: any) => (
          <li class="nav__item"><a class="label" href={l.href}>{l.label}</a></li>
        ))}
        <li><a class="btn btn--small" href={site.bookingUrl}>Book a call</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: saturate(1.2) blur(6px);
    border-bottom: 1px solid var(--rule);
  }
  .nav__inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 76px; }
  .nav__logo { width: 132px; color: var(--ink); }
  .nav__links { display: flex; align-items: center; gap: 36px; list-style: none; margin: 0; padding: 0; }
  .nav__links a.label { text-decoration: none; font-size: 11.5px; }
  @media (max-width: 860px) {
    .nav__item { display: none; }
    .nav__logo { width: 112px; }
    .nav__inner { min-height: 64px; }
  }
</style>
